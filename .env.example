# Docker Compose (только для docker-compose.yml): внешний HTTP-порт. 80 = открывать сайт как http://IP без :8000
# WEB_PUBLISH_PORT=80

# Django
# При DJANGO_DEBUG=false обязательно задайте уникальный DJANGO_SECRET_KEY (не оставляйте пустым).
DJANGO_SECRET_KEY=change-me-use-long-random-string
DJANGO_DEBUG=true
# На Vercel хост *.vercel.app добавляется автоматически (см. settings). Свой домен укажите явно:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Bishkek

# Database
# 1) PostgreSQL (Vercel + Supabase / Neon): одна строка URI, тогда DB_* не нужны.
#    Supabase: Project Settings → Database → Connection string → URI (Transaction pooler для serverless, порт 6543).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?sslmode=require
#    Для Docker Compose (PostgreSQL service `db`) можно использовать:
# DATABASE_URL=postgresql://magnat:magnat@db:5432/magnat_trade
# POSTGRES_DB=magnat_trade
# POSTGRES_USER=magnat
# POSTGRES_PASSWORD=magnat
#    Для pooler Django использует conn_max_age=0 автоматически; иначе: DATABASE_CONN_MAX_AGE=600
# 2) MySQL (сервер с mysqlclient, см. requirements-mysql.txt):
# DB_NAME=magnat_trade
# DB_USER=magnat
# DB_PASSWORD=magnat
# DB_HOST=127.0.0.1
# DB_PORT=3306
# 3) Локально без DATABASE_URL и без DB_NAME — SQLite (db.sqlite3)

# Redis (optional locally — без REDIS используется LocMem cache; Celery в docker-compose всё равно задаёт Redis)
# REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_IGNORE_RESULT=true
# Celery Beat: синхронизация с 1С (нужны worker + beat, см. docs/CELERY_BEAT_ONEC.md)
ONEC_BEAT_SYNC_ENABLED=true
# Частое обновление только товаров (GET productList + при пустом кэше categoryProductList). 0 = отключить (только полный цикл ниже).
ONEC_BEAT_PRODUCT_SYNC_MINUTES=5
# Полная синхронизация каждые N минут: categoryProductList → категории → зеркало shop → productList → counterpartyList (см. integrations.services.onec_full_sync). Для одного цикла раз в час: поставьте ONEC_BEAT_PRODUCT_SYNC_MINUTES=0 и ONEC_BEAT_FULL_SYNC_MINUTES=60
ONEC_BEAT_FULL_SYNC_MINUTES=60
# На полной синхронизации не тянуть контрагентов — быстрее
ONEC_BEAT_SKIP_CUSTOMERS=false
# Алерт в Telegram при N подряд ошибках синхронизации 1С (0 = выключить)
ONEC_SYNC_FAILURE_ALERT_THRESHOLD=3

# CORS (фронтенд)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS (production)
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_AT_BROWSER_CLOSE=true
SESSION_COOKIE_AGE=43200
LOG_LEVEL=INFO
LOG_LEVEL_SECURITY=INFO

# API интеграции 1С → сайт (POST sync, export, status)
# Используйте один из вариантов: X-API-Key или Basic Auth
INTEGRATION_API_KEY=your-long-random-secret
INTEGRATION_BASIC_USER=
INTEGRATION_BASIC_PASSWORD=

# Публикация HTTP-сервиса 1С (см. «Руководство к API.docx»)
# База до /hs, без завершающего слэша (endpoint'ы hs/categories/..., hs/products/... задаются в коде):
# ONEC_API_BASE_URL=https://rdp.it-help.kg:4443/bereke_test/hs
ONEC_API_BASE_URL=
# basic — как в руководстве. Приоритет: сначала ONEC_API_BASIC_AUTH, иначе USER+PASSWORD.
ONEC_AUTH_TYPE=basic
ONEC_API_BASIC_USER=
ONEC_API_BASIC_PASSWORD=
# Строка из curl после «Basic » (только base64, без префикса Basic — тоже ок)
ONEC_API_BASIC_AUTH=
# Для самоподписанного сертификата на тестовом сервере:
ONEC_VERIFY_SSL=false
# Резервный вариант из PDF (REST с Bearer):
# ONEC_AUTH_TYPE=bearer
# ONEC_API_TOKEN=
ONEC_API_SOURCE=website
# Доп. заголовки X-Source / X-Request-ID (1С обычно игнорирует)
ONEC_SEND_EXTRA_HEADERS=true
ONEC_API_TIMEOUT=120
# В выгрузке productList ключи retail/wholesale иногда противоположны нашим «розница/опт» — включено по умолчанию только для синхронизации из 1С (не для POST /api/v1/products/sync/).
# ONEC_PRODUCT_LIST_SWAP_PRICE_KEYS=true
# После регистрации на сайте — создать контрагента в 1С
ONEC_PUSH_ON_REGISTER=true
DEFAULT_WAREHOUSE_ID=MAIN
ORDER_EXPORT_TZ=Asia/Bishkek

# Публичный URL сайта (для payment_url в заглушке оплаты)
PUBLIC_SITE_URL=http://127.0.0.1:8000

# Только эти корневые разделы из дерева GET categoryProductList (названия как в 1С).
# Разделитель «|», чтобы сохранить запятую внутри названия категории.
# SHOP_NAV_ROOT_CATEGORY_NAMES=Аксессуары|Бумага и бумажная продукция.|Школа

# Оплата (webhook HMAC-SHA256, заголовок X-Signature = hex digest)
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=your-webhook-hmac-secret
PAYMENT_RETURN_URL=http://127.0.0.1:8000/checkout/success/

# Доставка
DELIVERY_PROVIDER=mock

# Telegram уведомления по заявкам (заказы/обратная связь/оптовый доступ)
TELEGRAM_NOTIFICATIONS_ENABLED=false
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID группы/чата (например -100xxxxxxxxxx)
TELEGRAM_GROUP_CHAT_ID=
# Отправлять уведомления в фоне (чтобы не задерживать ответ сайта)
TELEGRAM_ASYNC_SEND=true
# Таймаут HTTP-запроса к Telegram API (секунды)
TELEGRAM_HTTP_TIMEOUT=3

# DRF throttling
DRF_THROTTLE_ANON=120/minute
DRF_THROTTLE_USER=100/minute
DRF_THROTTLE_INTEGRATION=3000/minute
DRF_THROTTLE_WEBHOOK=600/minute
DRF_THROTTLE_AI_FREE=5/day
DRF_THROTTLE_AI_PRO=50/day

# Optional for Stripe-style webhooks
STRIPE_WEBHOOK_SECRET=

# Password reset token lifetime (seconds)
PASSWORD_RESET_TIMEOUT=3600

# Email delivery (verification / password reset)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@magnat-trade.local